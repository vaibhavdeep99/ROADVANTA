# ==============================================================================
# PRISM INSTANT AI — ENVIRONMENT SPECIFICATION (PLACEHOLDERS ONLY)
# ==============================================================================

# Application Environment
ENVIRONMENT=development
LOG_LEVEL=INFO
APP_HOST=0.0.0.0
APP_PORT=8001

# Security & Cryptography
# Generate a 256-bit secret key via: openssl rand -hex 32
JWT_SECRET_KEY=change_this_to_a_secure_random_64_character_hex_string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Secure Admin Bootstrap Secret (used ONLY during initial platform provisioning)
ADMIN_BOOTSTRAP_SECRET=change_this_to_a_bootstrap_secret_for_initial_admin_setup

# Database Configuration
# Local SQLite fallback: sqlite:///./data/prism_instant.db
# Production PostgreSQL: postgresql+psycopg2://user:password@postgres:5432/prism_instant_db
DATABASE_URL=sqlite:///./data/prism_instant.db

# Storage Engine (Local directory for development, private volume for production)
PRIVATE_STORAGE_PATH=./storage/private

# Ultralytics AI Model Path (YOLOv8 weights for road damage detection)
MODEL_WEIGHTS_PATH=../../prism_backend/models/best.pt
MODEL_CONFIDENCE_THRESHOLD=0.25
MODEL_IOU_THRESHOLD=0.45

# Video Processing Controls
MAX_VIDEO_DURATION_SECONDS=180
VIDEO_SAMPLING_INTERVAL_SECONDS=1.0

# CORS Allowed Origins (Comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Rate Limiting Controls
RATE_LIMIT_LOGIN_MAX=10
RATE_LIMIT_LOGIN_WINDOW_SEC=60
RATE_LIMIT_SCAN_MAX=20
RATE_LIMIT_SCAN_WINDOW_SEC=60
