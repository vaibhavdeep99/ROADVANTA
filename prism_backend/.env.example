# ====================================================
# RoadVanta AI - FastAPI YOLOv8 Perception Engine Env
# ====================================================

# Port for Uvicorn ASGI Server (Render/Railway inject PORT automatically)
PORT=8000

# Primary Trained YOLOv8 Defect Weights File
POTHOLE_MODEL_PATH=./models/best.pt

# Defect Confidence Threshold (0.15 for high sensitivity across phone crops & Indian roads)
POTHOLE_CONFIDENCE_THRESHOLD=0.15

# Database URL (SQLite default, or postgresql://user:pass@host:5432/db for cloud PostgreSQL)
PRISM_DATABASE_URL=sqlite:///./prism_road.db

# Host binding for cloud deployment
HOST=0.0.0.0
